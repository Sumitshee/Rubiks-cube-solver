{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "3D viewer",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/bin/Release/rubiks_gui.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "CLI: Kociemba solve (25-move scramble)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/bin/Release/rubiks_solver.exe",
      "args": ["--scramble", "25", "--seed", "42", "--solve"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "CLI: Korf optimal solve, 14 moves proved (8 threads)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/bin/Release/rubiks_solver.exe",
      "args": ["--scramble", "14", "--seed", "21", "--optimal", "--threads", "8"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "CLI: show the heuristic lower bound",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/bin/Release/rubiks_solver.exe",
      "args": ["--scramble", "25", "--seed", "42", "--heuristic", "--net"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Tests (all 318)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/bin/Release/rubik_tests.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Tests (debug a single suite)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/bin/Debug/rubik_tests.exe",
      "args": ["--gtest_filter=OptimalSolver*"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Benchmark: heuristic strength",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/bin/Release/rubiks_bench.exe",
      "args": ["--suite", "distribution", "--samples", "20000", "--with-7edge"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Benchmark: thread scaling",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/bin/Release/rubiks_bench.exe",
      "args": ["--suite", "threads", "--depths", "11,12", "--samples", "2"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
